# Copia este fichero como .env y rellena tus valores reales.
# NUNCA subas el .env real a git (ya está en .gitignore).

GEMINI_API_KEY=tu_api_key_aqui

# Solo hace falta para el servidor de telefonía real (server.py). Cópialo
# de la consola de Twilio (Account -> Auth Token). Sin esto el servidor no
# arranca - se usa para validar que las peticiones vienen de verdad de
# Twilio y no de cualquiera que encuentre la URL pública.
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aqui

# Solo hace falta para "pizzai-call" (disparar una llamada saliente hacia tu
# móvil en vez de llamar tú - evita tarifas internacionales de tu operadora).
# TWILIO_ACCOUNT_SID: dashboard de la consola de Twilio, junto al Auth Token.
# TWILIO_PHONE_NUMBER: el número que compraste, formato +1XXXXXXXXXX.
# TWILIO_ACCOUNT_SID=tu_account_sid_aqui
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Opcional - por si luego quieres cambiar de modelo sin tocar código
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Opcional - fuerza qué dispositivo de audio usar por nombre (busca substring,
# case-insensitive). Si no se define, se usa el dispositivo por defecto del sistema.
# INPUT_DEVICE_NAME=USB Condenser
# OUTPUT_DEVICE_NAME=Auriculares

# Opcional - sube a DEBUG para depurar audio (verás "mic callback #N",
# "Micrófono activo", "Audio enviado a Gemini" en cada chunk).
# LOG_LEVEL=DEBUG

# Opcional - silencio del cliente antes de confirmar el pedido: a los
# IDLE_CHECKIN_SECONDS le preguntamos si sigue ahí; a los IDLE_HANGUP_SECONDS
# colgamos si sigue sin responder. Bájalos para probar sin esperar minutos.
# IDLE_CHECKIN_SECONDS=20
# IDLE_HANGUP_SECONDS=45

# Opcional - silencio del cliente DESPUÉS de confirmar el pedido: no se
# pregunta "¿sigues ahí?" (no tiene sentido), directamente se le pide al
# modelo que se despida y cuelgue a los IDLE_POST_CONFIRM_NUDGE_SECONDS, y
# si ni así reacciona, se corta sin más a los IDLE_HANGUP_AFTER_CONFIRM_SECONDS.
# IDLE_POST_CONFIRM_NUDGE_SECONDS=8
# IDLE_HANGUP_AFTER_CONFIRM_SECONDS=20

# Opcional - tras decir "hasta luego" y llamar a finalizar_llamada, cuánto
# esperar (con el micro aún abierto) antes de colgar de verdad, por si el
# cliente responde con su propio "hasta luego" a la vez.
# HANGUP_GRACE_SECONDS=3
